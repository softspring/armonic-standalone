{% trans_default_domain 'sfs_cms_blocks' %}

{% if app.user %}
    <div class="dropdown">
        <a href="#" class="d-block link-dark text-decoration-none dropdown-toggle" id="dropdownUser1"
           data-bs-toggle="dropdown" aria-expanded="false">
            <img alt="{{ app.user.displayName }}" src="{{ app.user.avatarUrl }}" width="32" height="32"
                 class="rounded-circle">
        </a>
        <ul class="dropdown-menu text-small dropdown-menu-end" aria-labelledby="dropdownUser1" data-popper-placement="bottom-start">
            <li><a class="dropdown-item" href="{{ url('sfs_user_change_password') }}">{{ 'user_dropdown.change_password.link'|trans }}</a></li>
            <li><a class="dropdown-item" href="{{ url('sfs_user_preferences') }}">{{ 'user_dropdown.settings.link'|trans }}</a></li>
            {% if is_granted('ROLE_ADMIN') %}
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="{{ url('admin_dashboard') }}" target="_blank">{{ 'user_dropdown.admin_panel.link'|trans }}</a></li>
            {% endif %}
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="{{ url('sfs_user_logout') }}">{{ 'user_dropdown.sing_out.link'|trans }}</a></li>
        </ul>
    </div>
{% else %}
    <a href="{{ path('sfs_user_login') }}" class="btn btn-primary">{{ 'user_dropdown.sign_in.link'|trans }}</a>
    <a href="{{ path('sfs_user_register') }}" class="btn btn-primary">{{ 'user_dropdown.sign_up.link'|trans }}</a>
{% endif %}
