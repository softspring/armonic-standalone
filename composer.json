            "options": {
                "symlink": true
            }
        },
        {
            "url": "../cms-translation-plugin",
            "type": "path",
            "options": {
                "symlink": true
            }
        },
        {
            "url": "../cms-sections-plugin",
            "type": "path",
            "options": {
                "symlink": true
            }
        },
        {
